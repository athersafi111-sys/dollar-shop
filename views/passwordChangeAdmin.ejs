<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Change Admin Password</title>
  <link rel="stylesheet" href="/stylesheets/style.css">
  <style>
    body{ background:#f8fafc; font-family:Inter,sans-serif; display:flex; justify-content:center; align-items:center; min-height:100vh; margin:0; }
    .card{ background:white; border:1px solid #e2e8f0; border-radius:18px; padding:24px; width:90%; max-width:420px; box-shadow:0 10px 30px rgba(0,0,0,0.07); }
    .card h1{ font-size:20px; font-weight:800; text-align:center; margin-bottom:6px; color:#0f172a; }
    .sub{ text-align:center; color:#64748b; font-size:13px; margin-bottom:18px; }
    .input-group{ margin-bottom:14px; }
    .input-group label{ font-size:12px; font-weight:600; color:#334155; display:block; margin-bottom:6px; text-transform:uppercase; letter-spacing:.5px; }
    .input-group input{ width:100%; padding:12px; border:1px solid #e2e8f0; border-radius:10px; background:#f8fafc; box-sizing:border-box; outline:none; }
    .input-group input:focus{ border-color:#16a34a; background:white; }
    .btn{ width:100%; padding:12px; background:linear-gradient(135deg,#16a34a,#15803d); color:white; border:none; border-radius:10px; font-weight:700; cursor:pointer; margin-top:10px; }
    .msg{ padding:10px; border-radius:8px; font-size:13px; margin-bottom:12px; text-align:center; }
    .success{ background:#dcfce7; color:#166534; border:1px solid #bbf7d0; }
    .error{ background:#fee2e2; color:#991b1b; border:1px solid #fecaca; }
    .back{ display:block; text-align:center; margin-top:14px; color:#64748b; text-decoration:none; font-size:13px; }
  </style>
</head>
<body>
  <div class="card">
    <h1>🔐 Change Admin Password</h1>
    <p class="sub">Current: <%= adminEmail %></p>

    <% if(msg){ %><div class="msg success"><%= msg %></div><% } %>
    <% if(error){ %><div class="msg error"><%= error %></div><% } %>

    <form action="/changeAdminPassword" method="POST">
      <div class="input-group">
        <label>Current Password</label>
        <input type="password" name="currentPassword" required placeholder="Enter current password">
      </div>
      <div class="input-group">
        <label>New Admin Email</label>
        <input type="email" name="newEmail" value="<%= adminEmail %>" required>
      </div>
      <div class="input-group">
        <label>New Password</label>
        <input type="password" name="newPassword" required placeholder="New password">
      </div>
      <div class="input-group">
        <label>Confirm New Password</label>
        <input type="password" name="confirmPassword" required placeholder="Confirm new password">
      </div>
      <button class="btn" type="submit">Update Password</button>
    </form>
    <a class="back" href="/dollarAdmin">← Back to Admin Panel</a>
  </div>
</body>
</html>