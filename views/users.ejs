<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All Users</title>
    <style>
      body{ background:#f8fafc; font-family:Inter,sans-serif; margin:0; padding:20px; }
      .header{ display:flex; justify-content:space-between; align-items:center; max-width:1100px; margin:0 auto 20px; }
      .btn{ background:#0f172a; color:white; padding:10px 18px; border-radius:10px; text-decoration:none; font-weight:600; font-size:13px; }
      h1{ text-align:center; color:#0f172a; }
      .users{ display:grid; grid-template-columns:repeat(auto-fill,minmax(260px,1fr)); gap:16px; max-width:1100px; margin:0 auto; }
      .user{ background:white; border:1px solid #e2e8f0; border-radius:16px; padding:16px; display:flex; gap:12px; align-items:center; box-shadow:0 4px 12px rgba(0,0,0,.05); }
      .user img{ width:70px; height:70px; border-radius:12px; object-fit:cover; border:1px solid #eee; }
      .info{ flex:1; }
      .info h3{ margin:2px 0; font-size:14px; color:#0f172a; word-break:break-all; }
      .info p{ margin:0; font-size:12px; color:#64748b; }
      .actions{ display:flex; gap:8px; margin-top:8px; }
      .actions a{ padding:6px 10px; border-radius:8px; text-decoration:none; font-size:12px; font-weight:700; }
      .edit{ background:#e0f2fe; color:#0369a1; }
      .delete{ background:#fee2e2; color:#991b1b; }
      .delete:hover{ background:#fecaca; }
    </style>
</head>
<body class="dollarDisplayPage" style="background-color:<%= typeof bgColor!== 'undefined'? bgColor : '#ffffff' %>!important; min-height:100vh;">
  <div class="header">
    <a href="/dollarAdmin" class="btn">← Back to Admin</a>
    <span style="color:#64748b; font-size:13px;"><%= users.length %> users</span>
  </div>

  <h1>All Users</h1>
  <div class="users">
    <% if(users.length > 0){ %> 
      <% users.forEach(function(user){ %>
        <div class="user">
          <img src="<%= user.image %>" alt="">
          <div class="info">
            <h3><%= user.userName || user.username %></h3>
            <p><%= user.email %></p>
            <div class="actions">
              <a class="edit" href="/editUser/<%= user._id %>">Edit</a>
              <a class="delete" href="/deleteUser/<%= user._id %>" onclick="return confirm('Delete this user?')">Delete</a>
            </div>
          </div>
        </div>
      <% }) %>
    <% } else { %>
      <h3 style="grid-column:1/-1; text-align:center; color:#94a3b8;">NO USER YET</h3>
    <% } %>
  </div>
</body>
</html>