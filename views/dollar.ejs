<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/stylesheets/style.css">
    <style>
  .image img {
    cursor: pointer;
    transition: transform 0.3s ease;
    z-index: 5;
  }
  .image img.zoomed {
    transform: scale(1.5);
    z-index: 100;
    position: relative;
    box-shadow: 0 0 15px rgba(0,0,0,0.5);
    border-radius: 8px;
  }
  .search-box{
    width: 80%; max-width: 300px; padding: 8px 15px; 
    border: 1px solid #ccc; border-radius: 20px; outline: none;
  }
</style>
</head>
<body class="dollarDisplayPage" style="background-color:<%= bgColor %>;min-height : 100vh;">
    <h1 style="text-align: center;">One Dollar Page</h1>
    
    <% if(isAdmin){ %>
      <a class="btn" href="/logout" style="float:right;border;text-decoration: none;height: 26px;width: 110px;padding-left: 10px;">Logout Admin</a>
      <a class="btn" href="/dollarAdmin" style="float:right; margin-right:15px;text-decoration: none;height: 26px;width: 110px;padding-left: 10px;">Add Products</a>
    <% } %>
  <button class="btn" onclick="window.location.href='/'"> Home</button>

    <h3 style="text-align: center;">Household/kitchen items </h3>
    <div style="margin: 10px 0; text-align: center;">
      <input type="text" id="searchInput" placeholder="Search household..." class="search-box"
      onkeyup="filterCategory('searchInput', '.product', '.product-name')">
    </div>
    <div class="products" id="productsContainer">
      <% if(products.length > 0){ %> 
        <% products.forEach(function(product){ %>
          <% 
            let isNew = false;
            if(product.createdAt){
              let hoursDiff = (new Date() - new Date(product.createdAt)) / (1000*60*60);
              if(hoursDiff < 24) isNew = true;
            } else if(product._id){
              let hoursDiff = (new Date() - new Date(parseInt(product._id.toString().substring(0,8), 16)*1000)) / (1000*60*60);
              if(hoursDiff < 24) isNew = true;
            }
          %>
          <div class="product" style="position:relative;">
            <% if(isNew){ %>
              <span style="position:absolute; top:0px; right:25px; background:red; color:white; padding:1px 8px; border-radius:10px; font-size:8px; font-weight:bold; z-index:10;">NEW</span>
            <% } %>
            <div>
                <figure class="image">
                    <img onclick="zoomTemp(this)" src="<%= product.image %>" alt="" height="70" width="80">
                    <figcaption style="font-weight: bold;text-align: center;" class="product-name"><%= product.name %></figcaption>
                </figure>
            </div>
            <% if(typeof isAdmin !== 'undefined' && isAdmin){ %>
              <div class="editDelete">
                <a href="/delete/<%= product._id %>">Delete</a>
                <a href="/editProduct/<%= product._id %>">Edit</a>
              </div>
            <% } %>
          </div>
        <% }) %>
      <% } else { %>
          <h3>NO Product YET</h3>
      <% } %>
    </div>
    
