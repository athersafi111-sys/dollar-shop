<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body class="dollarDisplayPage" style="background-color:<%= typeof bgColor!== 'undefined'? bgColor : '#ffffff' %>!important; min-height:100vh;">
    <div style="padding:20px; text-align:center; font-family: sans-serif;">
  <h2 style="color:#111;">📍 Tamman Dollar Shop <br>Tamman Village</h2>
  <button class="btn" onclick="window.location.href='/'"> Home</button>
  <p style="color:#555;">Tamman, Talagang, Punjab, Pakistan</p>
  <div style="margin:20px 0; box-shadow:0 4px 15px rgba(0,0,0,0.2); border-radius:15px; overflow:hidden;">
    <iframe 
      src="https://www.google.com/maps?q=33.00324710912592,72.10975347513904&z=18&output=embed" 
      width="100%" 
      height="400" 
      style="border:0;" 
      allowfullscreen="" 
      loading="lazy">
    </iframe>
  </div>

  <!-- Directions Button -->
  <a href="https://www.google.com/maps/dir/?api=1&destination=33.00324710912592,72.10975347513904" 
     target="_blank"
     style="display:inline-block; background:#4285F4; color:white; padding:15px 30px; border-radius:10px; text-decoration:none; font-size:18px; font-weight:bold; margin:5px;">
     📍 Get Directions on Google Maps
  </a>
  
  <br><br>
  
  <a href="https://www.google.com/maps/search/?api=1&query=33.00324710912592,72.10975347513904" 
     target="_blank"
     style="display:inline-block; background:#25D366; color:white; padding:12px 25px; border-radius:10px; text-decoration:none; font-weight:bold; margin:5px;">
     Open in Google Maps App
  </a>
</div>
</body>
</html>