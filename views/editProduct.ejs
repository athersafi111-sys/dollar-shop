<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
     <link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body>
    <h1>Update Product</h1>
    <div>
        <h3>Household/kitchen items</h3>
        <form action="/update/<%= product._id %>"  method="post">
            <input placeholder="name" type="text" name="name" value="<%= product.name %>">
            <input placeholder="image url" type="text" name="image" value="<%= product.image %>">
            <input placeholder="detail" type="text" name="detail"value="<%= product.detail %>">
            <input type="submit" value="Update Product">
    </form>
    </div>
</body>
</html>